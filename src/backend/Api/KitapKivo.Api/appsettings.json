{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "KitapKivo.Api",
    "Audience": "KitapKivo.Client",
    "ExpirationMinutes": 15
  },
  "RefreshToken": {
    "ExpirationDays": 30,
    "CookieName": "KitapKivo.RefreshToken"
  },
  "Catalog": {
    "OpenLibrary": {
      "BaseUrl": "https://openlibrary.org",
      "TimeoutSeconds": 30,
      "UserAgent": "KitapKivo/1.0"
    },
    "ImportJobs": {
      "WorkerEnabled": true,
      "PollIntervalSeconds": 5,
      "DelayBetweenPagesSeconds": 2,
      "MaximumRetryCount": 5,
      "InitialRetryDelaySeconds": 15,
      "MaximumRetryDelaySeconds": 900,
      "InterruptedJobTimeoutMinutes": 60
    }
  },
  "AllowedHosts": "*"
}